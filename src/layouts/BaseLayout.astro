---
import '../styles/global.css';
// Letter/1in margins, 1.5 body spacing, unclipped tables, and collapsed
// disclosures forced open. The capstone guide prescribes print output, so it is
// part of the site rather than an afterthought in a print dialog.
import '../styles/print.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import BackToTop from '../components/BackToTop.astro';
import { toRoutePath, withBase } from '../lib/url';

interface Props {
  title?: string;
  description: string;
}

const {
  title,
  description,
} = Astro.props;

const siteName = 'PROJECT CLOIE';
const pageTitle = title ? `${title} · ${siteName}` : siteName;
const currentPath = toRoutePath(Astro.url.pathname);
const canonical = Astro.site ? new URL(withBase(currentPath), Astro.site) : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />

    {/*
      Manrope and Inter are self-hosted variable fonts (`src/styles/fonts.css`,
      73 KB for the full used weight range). Preloading the heading face — it
      paints first, on the header and hero — avoids a swap-driven reflow of the
      largest text on the page. Upstream preloads through `next/font`; this is
      the framework-free equivalent.
    */}
    <link rel="preload" href={withBase('/fonts/manrope-latin-var.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={withBase('/fonts/inter-latin-var.woff2')} as="font" type="font/woff2" crossorigin />

    {/*
      Applies the stored/system theme before first paint so there is no flash
      of the wrong palette. Mirrors the logic in `src/scripts/theme.ts`, which
      owns the toggle button.

      Upstream's "synchronous first-paint bootstrap" contract: resolve before
      paint, never in a hydration pass. `.dark` is the only theme selector in
      the stylesheet — every component resolves through a semantic role instead
      of branching on the theme — while `data-theme` stays as plain state for
      the toggle to read and write.
    */}
    <script is:inline>
      (() => {
        const KEY = 'cloie-theme';
        const root = document.documentElement;
        root.classList.add('js');

        const stored = localStorage.getItem(KEY);
        const system = window.matchMedia('(prefers-color-scheme: dark)');
        const resolve = () =>
          stored === 'dark' || stored === 'light' ? stored : system.matches ? 'dark' : 'light';

        const apply = (theme) => {
          root.dataset.theme = theme;
          root.classList.toggle('dark', theme === 'dark');
        };

        apply(resolve());

        // Follow the OS only while the visitor has not made an explicit choice.
        system.addEventListener('change', (event) => {
          const current = localStorage.getItem(KEY);
          if (current !== 'dark' && current !== 'light') {
            apply(event.matches ? 'dark' : 'light');
          }
        });
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <div class="app">
      <Header currentPath={currentPath} />
      <main id="main">
        <slot />
      </main>
      <Footer />
      <BackToTop />
    </div>

    <script>
      import '../scripts/theme';
      import '../scripts/header';
      import '../scripts/reveal';
      import '../scripts/back-to-top';
    </script>
  </body>
</html>
