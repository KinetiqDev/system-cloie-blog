---
/**
 * The keyword list that follows an abstract.
 *
 * A component rather than inline markup because the styling is scoped here and
 * MDX cannot carry a `<style>` block. The capstone guide asks for three to five
 * keywords immediately after the abstract; the manuscript has five.
 */
interface Props {
  items: string[];
  /** Label before the list. */
  label?: string;
}

const { items, label = 'Keywords' } = Astro.props;

// Anchor for `aria-labelledby`, so the list is named by its visible label
// without the label becoming one of its own items. Derived from the label so
// the build stays deterministic.
const id = `keywords-${label.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<div class="keywords">
  <span class="keywords__label" id={`${id}-label`}>{label}</span>
  <ul class="keywords__list" aria-labelledby={`${id}-label`}>
    {items.map((item) => (
      <li class="keywords__item">{item}</li>
    ))}
  </ul>
</div>

<style>
  .keywords {
    margin-top: 28px;
    padding-top: 20px;
    border-top: 1px solid var(--cloie-border);
  }

  .keywords__label {
    display: block;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--cloie-text-muted);
    margin-bottom: 8px;
  }

  .keywords__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .keywords__item {
    font-size: 14px;
    color: var(--cloie-text-secondary);
    background: var(--cloie-bg-section-alt);
    border: 1px solid var(--cloie-border);
    border-radius: var(--radius-full);
    padding: 3px 12px;
  }

  [data-theme='dark'] .keywords__item {
    background: rgba(15, 168, 251, 0.08);
  }
</style>
