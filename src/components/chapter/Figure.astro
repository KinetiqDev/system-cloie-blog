---
import { getFigure, type FigureId } from '../../lib/figures';

/**
 * A numbered manuscript figure.
 *
 * Driven by the registry in `src/lib/figures.ts` rather than by inline props:
 * the number, caption and alt text are declared once, so the caption rendered
 * on the chapter page and the row on the List of Figures page cannot drift
 * apart. A chapter author writes `<Figure id="fig-4-1-context" />`.
 *
 * Caption sits below the image, per the capstone guide.
 */
interface Props {
  /** Registry key. See `FigureId` in `src/lib/figures.ts`. */
  id: FigureId;
  /**
   * Override the printed caption number, e.g. `4.3a`. The registry number is
   * the default.
   */
  number?: string;
  /** Override the caption text. */
  caption?: string;
}

const { id, number, caption } = Astro.props;
const figure = getFigure(id);
---

<figure class="figure-container" id={`${id}-figure`}>
  <img
    src={figure.src.src}
    width={figure.src.width}
    height={figure.src.height}
    alt={figure.alt}
    class="figure-image"
    loading="lazy"
    decoding="async"
  />
  <figcaption class="figure-caption">
    <strong>Figure {number ?? figure.number}.</strong> {caption ?? figure.caption}
  </figcaption>
</figure>
