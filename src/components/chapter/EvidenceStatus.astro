---
/**
 * An evidence-status pill.
 *
 * This is the manuscript's defining visual idiom. The CLOIE technical document
 * reports "Not reported" wherever evidence is missing rather than estimating a
 * completion rate, and the capstone guide explicitly rewards that ("evidence
 * over volume", "avoid unsupported claims"). Rendering that status as a
 * scannable badge keeps the honesty legible instead of burying it in prose.
 *
 * Tone discipline: `unreported` and `unresolved` are **muted, never red**. Red
 * would read as "this failed" when the content says "this is not yet
 * evidenced" — a materially different claim.
 */
type Status =
  | 'verified'
  | 'partial'
  | 'deferred'
  | 'changed'
  | 'unresolved'
  | 'unreported'
  | 'pending';

interface Props {
  status: Status;
  /** Override the visible label. Defaults to the canonical label for `status`. */
  label?: string;
}

const LABELS: Record<Status, string> = {
  verified: 'Verified',
  partial: 'Partial',
  deferred: 'Deferred',
  changed: 'Changed',
  unresolved: 'Unresolved',
  unreported: 'Not reported',
  pending: 'Pending',
};

const { status, label } = Astro.props;
const text = label ?? LABELS[status];
---

<span class:list={['evidence', `evidence--${status}`]}>
  <span class="evidence__dot" aria-hidden="true"></span>
  {text}
</span>

<style>
  .evidence {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px 2px 8px;
    border-radius: var(--radius-full);
    font-size: var(--font-size-label-sm);
    font-weight: 650;
    line-height: 1.7;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .evidence__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  /* Each state resolves to a semantic status role from `tokens.css`, so a
     state's ink and its wash are defined once and verified in both themes
     rather than hand-matched per variant. The status dot plus the text label
     carry the meaning; colour only reinforces it. */

  .evidence--verified {
    color: var(--status-success-main);
    background: var(--status-success-subtle);
    border-color: color-mix(in srgb, var(--status-success-main) 28%, transparent);
  }

  .evidence--partial {
    color: var(--status-warning-main);
    background: var(--status-warning-subtle);
    border-color: color-mix(in srgb, var(--status-warning-main) 32%, transparent);
  }

  .evidence--deferred,
  .evidence--changed {
    color: var(--link-color);
    background: var(--color-primary-soft);
    border-color: var(--primary-wash-border);
  }

  /* EXTENSION: `--status-caution`. "Action required, not yet failed" is not
     success, warning, or danger, and red would misreport it. */
  .evidence--unresolved,
  .evidence--pending {
    color: var(--status-caution-main);
    background: var(--status-caution-subtle);
    border-color: color-mix(in srgb, var(--status-caution-main) 26%, transparent);
  }

  /* Muted grey, not red: "not yet evidenced" is not "failed". */
  .evidence--unreported {
    color: var(--text-muted);
    background: color-mix(in srgb, var(--text-muted) 9%, transparent);
    border-color: color-mix(in srgb, var(--text-muted) 26%, transparent);
    font-weight: 600;
  }
</style>
