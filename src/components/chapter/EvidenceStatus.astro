---
/**
 * An evidence-status pill.
 *
 * This is the manuscript's defining visual idiom. The CLOIE technical document
 * reports "Not reported" wherever evidence is missing rather than estimating a
 * completion rate, and the capstone guide explicitly rewards that ("evidence
 * over volume", "avoid unsupported claims"). Rendering that status as a
 * scannable badge keeps the honesty legible instead of burying it in prose.
 *
 * Tone discipline: `unreported` and `unresolved` are **muted, never red**. Red
 * would read as "this failed" when the content says "this is not yet
 * evidenced" — a materially different claim.
 */
type Status =
  | 'verified'
  | 'partial'
  | 'deferred'
  | 'changed'
  | 'unresolved'
  | 'unreported'
  | 'pending';

interface Props {
  status: Status;
  /** Override the visible label. Defaults to the canonical label for `status`. */
  label?: string;
}

const LABELS: Record<Status, string> = {
  verified: 'Verified',
  partial: 'Partial',
  deferred: 'Deferred',
  changed: 'Changed',
  unresolved: 'Unresolved',
  unreported: 'Not reported',
  pending: 'Pending',
};

const { status, label } = Astro.props;
const text = label ?? LABELS[status];
---

<span class:list={['evidence', `evidence--${status}`]}>
  <span class="evidence__dot" aria-hidden="true"></span>
  {text}
</span>

<style>
  .evidence {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 2px 10px 2px 8px;
    border-radius: var(--radius-full);
    font-size: 12.5px;
    font-weight: 650;
    line-height: 1.7;
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .evidence__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
    flex: none;
  }

  .evidence--verified {
    color: #0a7a4f;
    background: rgba(16, 163, 127, 0.1);
    border-color: rgba(16, 163, 127, 0.28);
  }

  .evidence--partial {
    color: #9a6800;
    background: rgba(245, 158, 11, 0.12);
    border-color: rgba(245, 158, 11, 0.32);
  }

  .evidence--deferred,
  .evidence--changed {
    color: var(--cloie-blue-dark);
    background: rgba(15, 168, 251, 0.1);
    border-color: rgba(15, 168, 251, 0.26);
  }

  .evidence--unresolved,
  .evidence--pending {
    color: #a3460a;
    background: rgba(217, 119, 6, 0.1);
    border-color: rgba(217, 119, 6, 0.26);
  }

  /* Muted grey, not red: "not yet evidenced" is not "failed". */
  .evidence--unreported {
    color: var(--cloie-text-muted);
    background: rgba(100, 116, 139, 0.09);
    border-color: rgba(100, 116, 139, 0.26);
    font-weight: 600;
  }

  [data-theme='dark'] .evidence--verified {
    color: #34d399;
  }

  [data-theme='dark'] .evidence--partial {
    color: #fbbf24;
  }

  [data-theme='dark'] .evidence--deferred,
  [data-theme='dark'] .evidence--changed {
    color: var(--cloie-blue);
  }

  [data-theme='dark'] .evidence--unresolved,
  [data-theme='dark'] .evidence--pending {
    color: #fb923c;
  }

  [data-theme='dark'] .evidence--unreported {
    color: var(--cloie-text-muted);
    background: rgba(100, 116, 139, 0.14);
  }
</style>
