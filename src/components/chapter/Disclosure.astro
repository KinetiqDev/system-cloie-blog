---
/**
 * A collapsed detail block.
 *
 * "Evidence over volume" is easier to honour when deep detail is present but
 * not the default: the Gantt chart, the full use-case model, long schema
 * excerpts. A native `<details>` gives keyboard and screen-reader support for
 * free, which a JS disclosure would have to reimplement.
 */
interface Props {
  /** Always-visible label on the summary line. */
  label: string;
  /** Optional muted hint after the label, e.g. "not required by the guide". */
  hint?: string;
  /** Start expanded. */
  open?: boolean;
}

const { label, hint, open = false } = Astro.props;
---

<details class="disclosure" open={open}>
  <summary class="disclosure__summary">
    <span class="disclosure__label">{label}</span>
    {hint && <span class="disclosure__hint">{hint}</span>}
  </summary>
  <div class="disclosure__body">
    <slot />
  </div>
</details>

<style>
  .disclosure {
    margin: 20px 0;
    border: 1px solid var(--border-default);
    border-radius: var(--radius-lg);
    background: var(--surface-primary);
    overflow: hidden;
  }

  .disclosure__summary {
    cursor: pointer;
    padding: 13px 18px;
    font-size: 14.5px;
    font-weight: 650;
    color: var(--text-secondary);
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
    list-style: none;
    transition: background var(--transition-fast);
  }

  /* Hide the default marker in WebKit as well as Gecko. */
  .disclosure__summary::-webkit-details-marker {
    display: none;
  }

  .disclosure__summary::before {
    content: '▸';
    color: var(--color-primary);
    font-size: 12px;
    transition: transform var(--transition-fast);
    flex: none;
  }

  .disclosure[open] > .disclosure__summary::before {
    transform: rotate(90deg);
  }

  .disclosure__summary:hover {
    background: var(--primary-wash-subtle);
  }

  .disclosure__summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
  }

  .disclosure__hint {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-muted);
  }

  .disclosure__body {
    padding: 4px 18px 18px;
    border-top: 1px solid var(--border-subtle);
  }

  .disclosure__body > :first-child {
    margin-top: 14px;
  }

</style>
