---
import Icon from './Icon.astro';
import '../styles/back-to-top.css';
---

{/*
  The sentinel sits at the very top of the document; `back-to-top.ts` hides the
  button while the sentinel is on screen. It replaces the Framer Motion
  presence animation — the entry transition is plain CSS.
*/}
<div class="back-to-top-sentinel" data-back-to-top-sentinel aria-hidden="true"></div>

<button type="button" class="back-to-top" data-back-to-top aria-label="Back to top" hidden>
  <Icon name="arrow-up" size={20} />
</button>

<style>
  .back-to-top-sentinel {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
</style>
